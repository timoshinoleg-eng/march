# Database
POSTGRES_URL="postgres://user:password@host:port/database"
POSTGRES_URL_NON_POOLING="postgres://user:password@host:port/database"

# Telegram notifications
TELEGRAM_BOT_TOKEN="your_bot_token"
TELEGRAM_CHAT_ID="your_chat_id"

# Bitrix24 integration
BITRIX24_WEBHOOK="https://your-domain.bitrix24.ru/rest/1/webhook_code"
BITRIX24_MANAGER_ID="1"

# Admin panel
ADMIN_SECRET="your_secret_password"

# AI API
OPENROUTER_API_KEY="sk-..."

# Public site URL
NEXT_PUBLIC_SITE_URL="https://chatbot24.su"

# Optional: comma-separated list of extra allowed origins for API CORS
# Example for preview or secondary domains:
# CORS_ALLOWED_ORIGINS="https://chatbot24.su,https://www.chatbot24.su,http://localhost:3000"
CORS_ALLOWED_ORIGINS=""
